{
  "name": "zerohour",
  "version": "0.1.0",
  "private": true,
  "description": "Exam results that can't crash on results day: encrypted results pre-staged at the edge, only a 32-byte key released at zero hour.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx scripts/gen-results.ts",
    "stage": "tsx scripts/stage-local.ts",
    "release:local": "tsx scripts/release-local.ts",
    "verify": "tsx scripts/verify-local.ts",
    "deploy": "bash scripts/deploy.sh",
    "publish:batch": "tsx scripts/publish-batch.ts",
    "empty-buckets": "tsx scripts/empty-buckets.ts",
    "destroy": "bash scripts/destroy.sh",
    "bundle": "tsx scripts/bundle.ts",
    "web:build": "tsx scripts/build-web.ts",
    "web:serve": "tsx scripts/serve-local.ts",
    "web:upload": "tsx scripts/upload-web.ts",
    "approvers:invite": "tsx scripts/invite-approvers.ts",
    "release:start": "tsx scripts/start-release.ts",
    "release:schedule": "tsx scripts/schedule-release.ts",
    "loadtest": "k6 run loadtest/results-day.js"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1165.0",
    "@aws-sdk/client-cloudfront": "^3.1167.0",
    "@aws-sdk/client-cloudwatch": "^3.1168.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/client-kms": "^3.1165.0",
    "@aws-sdk/client-lambda": "^3.1168.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/client-sfn": "^3.1165.0",
    "@aws/durable-execution-sdk-js-testing": "^1.3.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@aws/durable-execution-sdk-js": "^3.0.0"
  }
}
